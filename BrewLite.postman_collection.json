{
	"info": {
		"name": "BrewLite API - Task 2, 6, 7, 8 & 10 availability",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Products",
			"item": [
				{
					"name": "Selection Availability (Size and Toppings)",
					"request": {
						"method": "GET",
						"url": "http://localhost:3001/products/1/availability?size=L&toppingIds=cream,pearls"
					}
				},
				{
					"name": "Cart Availability (Shared Ingredients)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"1\", \"size\": \"S\", \"toppingIds\": [], \"qty\": 3 },\n    { \"productId\": \"2\", \"size\": \"L\", \"toppingIds\": [\"cream\"], \"qty\": 1 }\n  ]\n}"
						},
						"url": "http://localhost:3001/products/availability"
					}
				},
				{
					"name": "Get All Products",
					"request": {
						"method": "GET",
						"url": "http://localhost:3001/products"
					}
				},
				{
					"name": "Get Product By ID",
					"request": {
						"method": "GET",
						"url": "http://localhost:3001/products/1"
					}
				},
				{
					"name": "Get Product By ID (Not Found)",
					"request": {
						"method": "GET",
						"url": "http://localhost:3001/products/999"
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@gmail.com\",\n    \"password\": \"123456\"\n}"
						},
						"url": "http://localhost:3001/auth/register"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@gmail.com\",\n    \"password\": \"123456\"\n}"
						},
						"url": "http://localhost:3001/auth/login"
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer <YOUR_JWT_TOKEN>"
							}
						],
						"url": "http://localhost:3001/auth/me"
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Cancel Own Order (Repeat Does Not Refund Twice)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer <YOUR_JWT_TOKEN>" }
						],
						"url": "http://localhost:3001/orders/<ORDER_ID>/cancel",
						"description": "Task 10c: cancel an owned PENDING/PAYMENT_FAILED/PAID order. Returns CANCELLED, cancelReason, cancelledAt and expiresAt. Repeat requests do not refund stock twice."
					}
				},
				{
					"name": "Create Order",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer <YOUR_JWT_TOKEN>"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"items\": [\n        {\n            \"productId\": \"3\",\n            \"size\": \"M\",\n            \"toppingIds\": [\n                \"cream\",\n                \"pearls\"\n            ],\n            \"qty\": 1\n        },\n        {\n            \"productId\": \"4\",\n            \"size\": \"L\",\n            \"toppingIds\": [],\n            \"qty\": 2\n        }\n    ]\n}"
						},
						"url": "http://localhost:3001/orders"
					}
				},
				{
					"name": "Create Order (Empty Items - 400)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer <YOUR_JWT_TOKEN>"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"items\": []\n}"
						},
						"url": "http://localhost:3001/orders"
					}
				},
				{
					"name": "Create Order (No Token - 401)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"items\": [\n        {\n            \"productId\": \"1\",\n            \"size\": \"S\",\n            \"toppingIds\": [],\n            \"qty\": 1\n        }\n    ]\n}"
						},
						"url": "http://localhost:3001/orders"
					}
				}
			]
		},
		{
			"name": "Payments",
			"item": [
				{
					"name": "Create Payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer <YOUR_JWT_TOKEN>"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{$guid}}"
							}
						],
						"url": "http://localhost:3001/payments",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"orderId\": \"<ORDER_ID>\",\n    \"method\": \"WALLET\"\n}"
						}
					}
				},
				{
					"name": "Create Payment (Missing Idempotency-Key - 400)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer <YOUR_JWT_TOKEN>"
							}
						],
						"url": "http://localhost:3001/payments",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"orderId\": \"<ORDER_ID>\",\n    \"method\": \"CARD\"\n}"
						}
					}
				},
				{
					"name": "Get Payment",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer <YOUR_JWT_TOKEN>"
							}
						],
						"url": "http://localhost:3001/payments/<PAYMENT_ID>"
					}
				},
				{
					"name": "Mock Gateway - Payment Info",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:3001/mock-gateway/<PAYMENT_ID>"
					}
				},
				{
					"name": "Mock Gateway - Confirm SUCCESS",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "http://localhost:3001/mock-gateway/<PAYMENT_ID>/confirm",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"result\": \"SUCCESS\"\n}"
						}
					}
				},
				{
					"name": "Mock Gateway - Confirm FAILED",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "http://localhost:3001/mock-gateway/<PAYMENT_ID>/confirm",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"result\": \"FAILED\"\n}"
						}
					}
				},
				{
					"name": "Callback (Invalid Signature - 400)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "http://localhost:3001/payments/callback",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"paymentId\": \"<PAYMENT_ID>\",\n    \"result\": \"SUCCESS\",\n    \"signature\": \"invalid\"\n}"
						}
					}
				}
			]
		}
	]
}
