PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite
# BẮT BUỘC — app sẽ báo lỗi khi khởi động nếu biến này trống
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Tài khoản nhân viên (ADMIN) tạo sẵn khi khởi động — dùng để xác nhận thanh toán
ADMIN_EMAIL=admin@brewlite.vn
ADMIN_PASSWORD=admin123
# Thời gian chờ thanh toán của 1 đơn (phút)
ORDER_PAYMENT_TIMEOUT_MINUTES=15
